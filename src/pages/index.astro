---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FaixaSegmentos from '../components/FaixaSegmentos.astro';
import Segmentos from '../components/Segmentos.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import PorQue from '../components/PorQue.astro';
import Origem from '../components/Origem.astro';
import ProvaSocial from '../components/ProvaSocial.astro';
import Faq from '../components/Faq.astro';
import Galeria from '../components/Galeria.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Rodape from '../components/Rodape.astro';
import BotaoFlutuante from '../components/BotaoFlutuante.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
---

<Base>
  <Preloader />
  <Header />
  <main id="conteudo">
    <Hero />
    <FaixaSegmentos />
    <Segmentos />
    <ComoFunciona />
    <PorQue />
    <Origem />
    <ProvaSocial />
    <Faq />
    <Galeria />
    <CtaFinal />
  </main>
  <Rodape />
  <BotaoFlutuante />
  <AvisoCookies />
</Base>
