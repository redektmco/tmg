---
import { site } from '../lib/site';

const { cookies, rastreamento } = site;
const ativo = Boolean(rastreamento.ga4 || rastreamento.metaPixel);
---

{
  ativo && (
    <div class="cookies" role="dialog" aria-live="polite" aria-label="Aviso de cookies" data-cookies hidden>
      <p>{cookies.texto}</p>
      <div class="cookies__botoes">
        <button type="button" class="botao botao-contorno" data-cookies-recusar>
          {cookies.recusar}
        </button>
        <button type="button" class="botao cookies__aceitar" data-cookies-aceitar>
          {cookies.aceitar}
        </button>
      </div>
    </div>
  )
}

<style>
  .cookies {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(12px + var(--safe-bottom));
    z-index: 60;
    display: grid;
    gap: 12px;
    padding: 16px;
    border-radius: 20px;
    background: #fff;
    color: var(--color-tinta);
    font-size: 0.9rem;
    box-shadow: 0 24px 60px -20px rgb(6 26 66 / 0.55);
  }

  .cookies[hidden] {
    display: none;
  }

  .cookies__botoes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .cookies .botao {
    min-height: 44px;
    padding: 10px 16px;
    font-size: 0.9rem;
  }

  .cookies__aceitar {
    background: var(--color-azul-tmg);
    color: #fff;
  }

  @media (min-width: 768px) {
    .cookies {
      left: 24px;
      right: auto;
      max-width: 420px;
    }
  }
</style>
