---
import { site } from '../lib/site';

interface Produto {
  nome: string;
  imagem: string;
  imagemAlt: string;
}

const { produtos } = site;
const itens: Produto[] = produtos.itens;
---

<section id="produtos" class="secao produtos" aria-labelledby="produtos-titulo">
  <div class="container-site">
    <h2 id="produtos-titulo" class="titulo-secao">{produtos.titulo}</h2>
    {itens.length > 0 && (
      <ul class="produtos__grade" role="list">
        {itens.map((item) => (
          <li class="produto">
            <img
              src={item.imagem}
              alt={item.imagemAlt}
              width="400"
              height="400"
              loading="lazy"
              decoding="async"
            />
            <h3>{item.nome}</h3>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .produtos {
    background: var(--color-gelo);
  }

  .produtos__grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 36px;
    padding: 0;
    list-style: none;
  }

  .produto {
    min-width: 0;
    padding: 20px 12px;
    border-radius: 24px;
    background: #fff;
  }

  .produto img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .produto h3 {
    margin-top: 16px;
    color: var(--color-azul-profundo);
    font-size: 1rem;
    line-height: 1.4;
    text-align: center;
  }

  @media (min-width: 768px) {
    .produtos__grade {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }

    .produto {
      padding: 24px;
    }
  }
</style>
