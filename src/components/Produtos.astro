---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BotaoWhatsApp from './BotaoWhatsApp.astro';
import Icone from './Icone.astro';
import { site } from '../lib/site';

interface Produto {
  nome: string;
  apresentacao: string;
  descricao: string;
  imagem: string;
  imagemAlt: string;
  imagemComplementar?: string;
  imagemComplementarAlt?: string;
}

const { produtos } = site;
const itens: Produto[] = produtos.itens;
const imagens = import.meta.glob<{ default: ImageMetadata }>('../assets/produtos/*.jpg', { eager: true });
function imagem(arquivo: string): ImageMetadata {
  const encontrada = imagens[`../assets/produtos/${arquivo}`]?.default;
  if (!encontrada) throw new Error(`Imagem do produto não encontrada: ${arquivo}`);
  return encontrada;
}
---

<section id="produtos" class="secao produtos" aria-labelledby="produtos-titulo">
  <div class="container-site">
    <div class="produtos__intro">
      <p class="etiqueta produtos__etiqueta">{produtos.etiqueta}</p>
      <h2 id="produtos-titulo" class="titulo-secao">{produtos.titulo}</h2>
      <p class="produtos__subtitulo">{produtos.subtitulo}</p>
    </div>

    <ul class="produtos__grade" role="list">
      {itens.map((item) => (
        <li class="produto">
          <div class:list={['produto__visual', { 'produto__visual--duplo': item.imagemComplementar }]}>
            <Image
              src={imagem(item.imagem)}
              alt={item.imagemAlt}
              widths={[240, 400, 640]}
              sizes="(min-width: 1200px) 210px, (min-width: 768px) 30vw, (min-width: 480px) 44vw, 90vw"
              format="webp"
              loading="lazy"
              decoding="async"
            />
            {item.imagemComplementar && (
              <Image
                src={imagem(item.imagemComplementar)}
                alt={item.imagemComplementarAlt ?? ''}
                widths={[160, 240, 400]}
                sizes="(min-width: 1200px) 105px, (min-width: 768px) 15vw, (min-width: 480px) 22vw, 45vw"
                format="webp"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <div class="produto__conteudo">
            <p class="produto__apresentacao">{item.apresentacao}</p>
            <h3>{item.nome}</h3>
            <p class="produto__descricao">{item.descricao}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="produtos__rodape">
      <a href={produtos.fonte} target="_blank" rel="noopener noreferrer" class="produtos__fonte">
        Ver catálogo Premium Lindoia <Icone nome="seta" tamanho={16} />
      </a>
      <BotaoWhatsApp origem="produtos" texto={produtos.botao} magnetico={false} />
    </div>
  </div>
</section>

<style>
  .produtos {
    background: var(--color-gelo);
  }

  .produtos__intro {
    max-width: 780px;
  }

  .produtos__etiqueta {
    margin-bottom: 16px;
    color: var(--color-azul-tmg);
  }

  .produtos__subtitulo {
    max-width: 640px;
    margin-top: 20px;
    color: var(--color-tinta-suave);
    font-size: 1.125rem;
  }

  .produtos__grade {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    margin-top: 36px;
    padding: 0;
    list-style: none;
  }

  .produto {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgb(11 46 111 / 0.08);
    border-radius: 24px;
    background: #fff;
  }

  .produto__visual {
    display: flex;
    height: 280px;
    overflow: hidden;
    background: #cfe9f1;
  }

  .produto__visual :global(img) {
    display: block;
    width: 100%;
    min-width: 0;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-agua);
  }

  .produto__visual--duplo :global(img) {
    width: 50%;
  }

  .produto__conteudo {
    padding: 20px;
  }

  .produto__apresentacao {
    margin-bottom: 10px;
    color: var(--color-azul-tmg);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .produto h3 {
    color: var(--color-azul-profundo);
    font-size: 1.125rem;
    line-height: 1.3;
    text-wrap: initial;
  }

  .produto__descricao {
    margin-top: 10px;
    color: var(--color-tinta-suave);
    font-size: 0.875rem;
  }

  .produtos__rodape {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 32px;
  }

  .produtos__fonte {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--color-azul-profundo);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 480px) {
    .produtos__grade {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .produtos__grade {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .produtos__grade {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 16px;
    }

    .produto__visual {
      height: 240px;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .produto:hover :global(img) {
      transform: scale(1.04);
    }
  }
</style>
