---
import BotaoWhatsApp from './BotaoWhatsApp.astro';
import Onda from './Onda.astro';
import Icone from './Icone.astro';
import { semQuebra, site } from '../lib/site';

const { hero } = site;
---

<section id="topo" class="hero" data-hero>
  <div class="hero__fundo" aria-hidden="true" data-hero-fundo>
    <div class="hero__brilho"></div>
    <div class="hero__raios" data-anima>
      <span></span><span></span><span></span><span></span>
    </div>
  </div>
  <canvas class="hero__bolhas" data-bolhas="hero" aria-hidden="true"></canvas>
  <div class="hero__vidros" aria-hidden="true" data-hero-vidros>
    <div class="hero__vidros-escala">
      <span class="vidro vidro--1"></span>
      <span class="vidro vidro--2"></span>
      <span class="vidro vidro--3"></span>
    </div>
  </div>

  <div class="container-site hero__conteudo" data-hero-conteudo>
    <p class="etiqueta hero__etiqueta" data-hero-item>
      <span class="hero__ponto" aria-hidden="true"></span>
      {hero.etiqueta}
    </p>
    <h1 class="hero__titulo" data-hero-titulo set:html={semQuebra(hero.titulo)} />
    <p class="hero__subtitulo" data-hero-item set:html={semQuebra(hero.subtitulo)} />
    <div class="hero__botoes" data-hero-item>
      <BotaoWhatsApp origem="hero" texto={hero.botaoPrincipal} class="w-full sm:w-auto" />
      <a href="#produtos" class="botao botao-claro w-full sm:w-auto" data-magnetico>
        <span>{hero.botaoSecundario}</span>
        <Icone nome="seta-baixo" tamanho={20} />
      </a>
    </div>
  </div>

  <Onda cor="var(--color-gelo)" espuma="var(--color-turquesa-claro)" />
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
    background: var(--color-azul-profundo);
    isolation: isolate;
  }

  .hero__fundo {
    position: absolute;
    inset: -10% 0 0;
    z-index: -2;
    background:
      radial-gradient(90% 55% at 50% -5%, rgb(127 224 234 / 0.55) 0%, rgb(25 181 200 / 0) 70%),
      linear-gradient(180deg, #13a4c2 0%, #1660d0 42%, #0b2e6f 78%, #082357 100%);
  }

  .hero__brilho {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40% 30% at 15% 20%, rgb(255 255 255 / 0.18), transparent 70%),
      radial-gradient(35% 25% at 85% 35%, rgb(127 224 234 / 0.2), transparent 70%);
  }

  .hero__raios {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__raios span {
    position: absolute;
    top: -20%;
    width: 18vw;
    min-width: 90px;
    height: 120%;
    background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.2) 50%, rgb(255 255 255 / 0));
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 78%);
    mask-image: linear-gradient(180deg, #000 0%, transparent 78%);
    transform-origin: 50% 0;
    animation: raio 9s ease-in-out infinite alternate;
  }

  .hero__raios span:nth-child(1) {
    left: 8%;
    transform: rotate(14deg);
  }

  .hero__raios span:nth-child(2) {
    left: 34%;
    width: 9vw;
    animation-duration: 11s;
    animation-delay: -3s;
    transform: rotate(8deg);
  }

  .hero__raios span:nth-child(3) {
    left: 58%;
    animation-duration: 13s;
    animation-delay: -6s;
    transform: rotate(-6deg);
  }

  .hero__raios span:nth-child(4) {
    left: 82%;
    width: 7vw;
    animation-duration: 10s;
    animation-delay: -1s;
    transform: rotate(-12deg);
  }

  @keyframes raio {
    from {
      transform: rotate(-10deg) scaleX(0.8);
      opacity: 0.55;
    }
    to {
      transform: rotate(10deg) scaleX(1.15);
      opacity: 1;
    }
  }

  .hero__bolhas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }

  .hero__vidros {
    display: none;
  }

  @media (min-width: 1200px) {
    .hero__vidros {
      display: block;
      position: absolute;
      right: max(24px, calc((100vw - 1200px) / 2 - 40px));
      top: 50%;
      width: 440px;
      height: 520px;
      margin-top: -260px;
      z-index: -1;
    }
  }

  .hero__vidros-escala {
    position: absolute;
    inset: 0;
    transform-origin: 100% 50%;
  }

  @media (max-width: 1365px) {
    .hero__vidros-escala {
      transform: scale(0.72);
    }
  }

  .vidro {
    position: absolute;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, rgb(255 255 255 / 0.85) 0 6%, rgb(255 255 255 / 0) 16%),
      radial-gradient(circle at 70% 78%, rgb(127 224 234 / 0.35), transparent 45%),
      radial-gradient(circle at 50% 50%, rgb(255 255 255 / 0.02) 55%, rgb(255 255 255 / 0.22) 72%, rgb(255 255 255 / 0.55) 100%);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.45),
      inset -18px -24px 60px rgb(11 46 111 / 0.25),
      0 30px 80px -30px rgb(3 13 36 / 0.6);
    animation: vidro-flutua 7s ease-in-out infinite alternate;
  }

  .vidro--1 {
    width: 300px;
    height: 300px;
    right: 0;
    top: 40px;
  }

  .vidro--2 {
    width: 150px;
    height: 150px;
    left: 0;
    top: 0;
    animation-duration: 9s;
    animation-delay: -3s;
  }

  .vidro--3 {
    width: 96px;
    height: 96px;
    left: 70px;
    bottom: 10px;
    animation-duration: 6s;
    animation-delay: -1.5s;
  }

  @keyframes vidro-flutua {
    from {
      transform: translate3d(0, 12px, 0);
    }
    to {
      transform: translate3d(0, -14px, 0);
    }
  }

  .hero__conteudo {
    position: relative;
    padding-top: calc(var(--altura-header) + 40px);
    padding-bottom: 120px;
  }

  .hero__etiqueta {
    padding: 8px 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: 0.68rem;
  }

  .hero__ponto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-turquesa-claro);
    box-shadow: 0 0 0 4px rgb(127 224 234 / 0.25);
  }

  .hero__titulo {
    margin-top: 20px;
    font-size: clamp(2.5rem, 11vw, 5.25rem);
    line-height: 1.02;
    max-width: 14ch;
    text-shadow: 0 10px 40px rgb(6 26 66 / 0.35);
  }

  .hero__subtitulo {
    margin-top: 20px;
    max-width: 38rem;
    font-size: 1.0625rem;
    color: rgb(255 255 255 / 0.88);
  }

  .hero__botoes {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (min-width: 640px) {
    .hero__botoes {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 1024px) {
    .hero__subtitulo {
      font-size: 1.25rem;
    }
  }
</style>
