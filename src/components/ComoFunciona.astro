---
import { Picture } from 'astro:assets';
import BotaoWhatsApp from './BotaoWhatsApp.astro';
import Onda from './Onda.astro';
import { foto, site } from '../lib/site';

const { comoFunciona } = site;
const ultimo = comoFunciona.passos.length - 1;
---

<section id="como-funciona" class="secao como-funciona" aria-labelledby="como-funciona-titulo">
  <div class="container-site como-funciona__grade">
    <div class="como-funciona__intro">
      <h2 id="como-funciona-titulo" class="titulo-secao" data-split>{comoFunciona.titulo}</h2>
      <p class="mt-4 text-lg text-tinta-suave" data-revela>{comoFunciona.subtitulo}</p>
      <BotaoWhatsApp origem="como-funciona" texto={comoFunciona.botao} class="mt-8 hidden lg:inline-flex" />
    </div>

    <ol class="passos" data-passos>
      <span class="passos__trilho" aria-hidden="true">
        <span class="passos__filete" data-filete></span>
        <span class="passos__gota" data-filete-gota></span>
      </span>
      {
        comoFunciona.passos.map((passo, i) => (
          <li class="passo" data-passo>
            <span class="passo__numero" aria-hidden="true">
              {i + 1}
            </span>
            <div class="passo__corpo" data-revela>
              <h3 class="passo__titulo">
                <span class="sr-only">Passo {i + 1}: </span>
                {passo.titulo}
              </h3>
              <p class="passo__texto">{passo.texto}</p>
              {i === ultimo && (
                <figure class="passo__foto">
                  <Picture
                    src={foto(comoFunciona.foto)}
                    alt={comoFunciona.fotoAlt}
                    formats={['avif', 'webp']}
                    widths={[360, 540, 720, 960]}
                    sizes="(min-width: 1024px) 440px, calc(100vw - 96px)"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="passo__selo">{comoFunciona.fotoSelo}</figcaption>
                </figure>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <BotaoWhatsApp origem="como-funciona" texto={comoFunciona.botao} class="w-full lg:hidden" />
  </div>

  <Onda cor="var(--color-gelo)" />
</section>

<style>
  .como-funciona {
    position: relative;
    background: #fff;
    padding-bottom: 128px;
  }

  .como-funciona__grade {
    display: grid;
    gap: 40px;
  }

  .passos {
    position: relative;
    display: grid;
    gap: 36px;
    padding-left: 64px;
  }

  .passos__trilho {
    position: absolute;
    left: 23px;
    top: 24px;
    bottom: 24px;
    width: 4px;
    border-radius: 4px;
    background: var(--color-gelo);
  }

  .passos__filete {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, var(--color-turquesa), var(--color-azul-tmg));
    transform-origin: 50% 0;
  }

  .passos__gota {
    position: absolute;
    left: 50%;
    top: 0;
    width: 14px;
    height: 18px;
    margin: -9px 0 0 -7px;
    background: var(--color-azul-tmg);
    clip-path: path('M7 0C7 0 14 8 14 11A7 7 0 0 1 0 11C0 8 7 0 7 0Z');
    opacity: 0;
  }

  .passo {
    position: relative;
  }

  .passo__numero {
    position: absolute;
    left: -64px;
    top: 0;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    font-family: var(--font-titulo);
    font-weight: 800;
    font-size: 1.25rem;
    color: #fff;
    background: linear-gradient(145deg, var(--color-turquesa), var(--color-azul-tmg));
    box-shadow:
      0 0 0 6px #fff,
      0 12px 24px -10px rgb(22 96 208 / 0.7);
    transition:
      transform 0.5s var(--ease-agua),
      filter 0.4s ease;
  }

  :global(html.fx) .passo:not(.passo--ativo) .passo__numero {
    filter: grayscale(1) brightness(1.6);
    transform: scale(0.85);
  }

  .passo__titulo {
    padding-top: 10px;
    font-size: 1.5rem;
    color: var(--color-azul-profundo);
  }

  .passo__texto {
    margin-top: 6px;
    color: var(--color-tinta-suave);
    font-size: 1.0625rem;
  }

  .passo__foto {
    position: relative;
    margin-top: 20px;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: 0 30px 60px -30px rgb(11 46 111 / 0.55);
  }

  .passo__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }

  .passo__selo {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    padding: 12px 16px;
    border-radius: 16px;
    font-family: var(--font-titulo);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-azul-profundo);
    background: rgb(255 255 255 / 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  @media (min-width: 1024px) {
    .como-funciona__grade {
      grid-template-columns: 5fr 6fr;
      gap: 80px;
      align-items: start;
    }

    .como-funciona__intro {
      position: sticky;
      top: calc(var(--altura-header) + 48px);
    }

    .passos {
      gap: 56px;
    }

    .passo__foto {
      max-width: 440px;
    }
  }
</style>
